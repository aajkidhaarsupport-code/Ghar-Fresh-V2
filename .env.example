# Everything is optional. The app works with none of these set.

PORT=3000
# Where the database and uploaded photos live. On Render, point this at a mounted disk (e.g. /data).
DATA_DIR=./data

# The first admin: this email becomes admin when it signs up. (Demo admin admin@gharfresh.in is always created.)
ADMIN_EMAIL=

# Real OTP + notification emails via Brevo (free tier). Without these, the OTP is shown on screen (demo mode).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GharFresh

# Keep the one-tap demo logins even after Brevo is configured (1 = keep, otherwise they disappear)
DEMO_LOGIN=

# FREE hosting data backup (Render free has no disk). Create table gf_state, see README.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
